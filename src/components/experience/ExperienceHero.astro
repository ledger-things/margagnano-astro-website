---
import Reveal from '../Reveal.tsx';
import I18n from '../I18n.astro';
import './ExperienceHero.css';
---

<section class="ex-hero" aria-label="The experience">
	<div class="ex-hero__bg" aria-hidden="true">
		<img
			src="/images/home/experience-coast.png"
			alt=""
			width="1920"
			height="1280"
			fetchpriority="high"
		/>
	</div>
	<div class="ex-hero__overlay" aria-hidden="true"></div>

	<div class="ex-hero__content">
		<Reveal client:load delay={0.12} y={28} duration={1.1}>
			<p class="ex-hero__script">the experience</p>
		</Reveal>
		<Reveal client:load delay={0.26} y={16} duration={0.9}>
			<span class="ex-hero__rule" aria-hidden="true"></span>
		</Reveal>
		<Reveal client:load delay={0.36} y={24} duration={1.05}>
			<h1 class="ex-hero__title">Beyond Margagnano</h1>
		</Reveal>
		<Reveal client:load delay={0.48} y={20} duration={1}>
			<p class="ex-hero__text">
				<I18n
					it="Dalla Valle d'Itria alla costa adriatica, un territorio fatto di paesaggi, borghi e tradizioni che completano l'esperienza di Masseria Margagnano."
					en="From the Valle d’Itria to the Adriatic coast, a landscape of countryside, villages and traditions that completes the experience of Masseria Margagnano."
				/>
			</p>
		</Reveal>
	</div>
</section>
