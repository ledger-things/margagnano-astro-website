---
// Prefooter: banner con citazione e stemma su sfondo dei tetti della masseria.
import Reveal from './Reveal.tsx';
---

<section id="prefooter" class="prefooter" aria-label="Citazione">
	<div class="prefooter__bg" aria-hidden="true"></div>
	<div class="prefooter__tint" aria-hidden="true"></div>
	<div class="prefooter__overlay" aria-hidden="true"></div>

	<div class="prefooter__inner">
		<Reveal client:visible inView delay={0.05}>
			<blockquote class="prefooter__quote">
				<p class="prefooter__quote-text">
					&ldquo;The only journey is the one within.&rdquo;
				</p>
				<cite class="prefooter__quote-author">rainer maria rilke</cite>
			</blockquote>
		</Reveal>

		<Reveal client:visible inView delay={0.2}>
			<img
				class="prefooter__crest"
				src="/logo/crest-white.svg"
				alt="Stemma Masseria Margagnano"
				width="236"
				height="325"
			/>
		</Reveal>
	</div>
</section>

<style>
	.prefooter {
		position: relative;
		width: 100%;
		min-height: clamp(360px, 60vh, 620px);
		overflow: hidden;
	}

	.prefooter__bg {
		position: absolute;
		inset: 0;
		background-image: url('/images/rooftops.png');
		background-size: cover;
		background-position: center;
	}

	.prefooter__tint {
		position: absolute;
		inset: 0;
		background-color: #d9d9d9;
		opacity: 0.5; /* regolabile: intensita' del layer colore */
	}

	.prefooter__overlay {
		position: absolute;
		inset: 0;
		background: linear-gradient(
			160deg,
			rgba(0, 0, 0, 0.35) 0%,
			rgba(0, 0, 0, 0.12) 35%,
			rgba(0, 0, 0, 0) 65%
		);
	}

	.prefooter__inner {
		position: relative;
		z-index: 1;
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 2rem;
		max-width: 90rem;
		margin: 0 auto;
		padding: clamp(2.5rem, 6vw, 5rem) clamp(1.5rem, 5vw, 5rem);
		color: #fff;
	}

	.prefooter__quote {
		margin: 0;
		flex: 1;
		min-width: 0;
		max-width: min(52rem, 72%);
	}

	.prefooter__quote-text {
		font-family: 'Times Sans Serif', serif;
		font-weight: 400;
		font-size: clamp(2rem, 4.5vw, 3rem); /* max 48px */
		line-height: 1.18;
		margin: 0;
	}

	.prefooter__quote-author {
		display: block;
		margin-top: clamp(0.75rem, 1.6vw, 1.25rem);
		font-family: 'Monsieur La Doulaise', cursive;
		font-weight: 400;
		font-style: normal;
		font-size: clamp(3rem, 7.5vw, 5rem); /* max 80px */
		line-height: 1;
		white-space: nowrap;
	}

	.prefooter__crest {
		flex-shrink: 0;
		height: clamp(84px, 12vw, 170px);
		width: auto;
		filter: drop-shadow(0 2px 14px rgba(0, 0, 0, 0.3));
	}

	@media (max-width: 640px) {
		.prefooter__inner {
			flex-direction: column;
			align-items: center;
			text-align: center;
			gap: 1.75rem;
		}

		.prefooter__quote {
			max-width: none;
		}

		.prefooter__quote-author {
			white-space: normal;
		}
	}
</style>
