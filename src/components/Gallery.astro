---
import Reveal from './Reveal.tsx';
import GallerySlider from './GallerySlider.tsx';
---

<section id="gallery" class="gallery" aria-labelledby="gallery-title">
	<div class="gallery__inner">
		<Reveal client:visible inView delay={0.05} y={20} className="gallery__reveal">
			<h2 id="gallery-title" class="gallery__title">Gallery</h2>
		</Reveal>

		<Reveal
			client:visible
			inView
			delay={0.15}
			y={28}
			duration={1}
			className="gallery__reveal gallery__reveal--slider"
		>
			<GallerySlider client:visible />
		</Reveal>
	</div>
</section>

<style>
	.gallery {
		background: #f4f1ea;
		color: var(--brand-terracotta);
		height: 100svh;
		min-height: 100svh;
		max-height: 100svh;
		overflow: hidden;
		box-sizing: border-box;
	}

	.gallery__inner {
		display: flex;
		flex-direction: column;
		justify-content: center;
		height: 100%;
		min-height: 0;
		padding: clamp(4.5rem, 8vh, 6rem) clamp(1rem, 4vw, 3rem) clamp(1.25rem, 3vh, 2.5rem);
		box-sizing: border-box;
	}

	.gallery :global(.gallery__reveal) {
		width: 100%;
		flex: 0 0 auto;
	}

	.gallery :global(.gallery__reveal--slider) {
		flex: 1 1 auto;
		min-height: 0;
		display: flex;
		align-items: center;
	}

	.gallery__title {
		margin: 0 0 clamp(0.75rem, 2vh, 1.5rem);
		text-align: center;
		font-family: 'Times Sans Serif', sans-serif;
		font-weight: 400;
		font-size: clamp(1.75rem, 3.2vw, 2.75rem);
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--brand-terracotta);
	}

	.gallery :global(.gallery-slider) {
		width: 100%;
		min-height: 0;
	}

	.gallery :global(.gallery-slider__stage) {
		position: relative;
		display: grid;
		grid-template-columns: auto minmax(0, 1fr) auto;
		align-items: center;
		gap: clamp(0.5rem, 2vw, 1.5rem);
		max-width: 72rem;
		margin: 0 auto;
	}

	.gallery :global(.gallery-slider__nav) {
		appearance: none;
		border: 0;
		background: transparent;
		color: var(--brand-marrone);
		font-size: 1.5rem;
		line-height: 1;
		padding: 0.35rem;
		cursor: pointer;
		transition: opacity 0.2s ease;
	}

	.gallery :global(.gallery-slider__nav:hover),
	.gallery :global(.gallery-slider__nav:focus-visible) {
		opacity: 0.55;
		outline: none;
	}

	.gallery :global(.gallery-slider__viewport) {
		min-width: 0;
		overflow: hidden;
		touch-action: pan-y;
		cursor: grab;
	}

	.gallery :global(.gallery-slider__viewport:active) {
		cursor: grabbing;
	}

	.gallery :global(.gallery-slider__track) {
		display: flex;
		width: max-content;
		will-change: transform;
	}

	.gallery :global(.gallery-slider__slide) {
		flex: 0 0 auto;
		min-width: 0;
	}

	.gallery :global(.gallery-slider__grid) {
		display: grid;
		grid-template-columns: 1.15fr 0.9fr 1.05fr;
		gap: 0.55rem;
		width: 100%;
		height: clamp(16rem, 58vh, 28rem);
		padding: 0 1px;
		box-sizing: border-box;
	}

	.gallery :global(.gallery-slider__stack) {
		display: grid;
		grid-template-rows: 1.15fr 1fr;
		gap: 0.55rem;
		min-height: 0;
		height: 100%;
	}

	.gallery :global(.gallery-slider__cell) {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		background: #ddd6c8;
		pointer-events: none;
		user-select: none;
	}

	.gallery :global(.gallery-slider__dots) {
		display: flex;
		justify-content: center;
		gap: 0.55rem;
		margin-top: clamp(0.75rem, 2vh, 1.25rem);
	}

	.gallery :global(.gallery-slider__dot) {
		width: 0.4rem;
		height: 0.4rem;
		padding: 0;
		border: 0;
		border-radius: 50%;
		background: rgba(107, 90, 68, 0.35);
		cursor: pointer;
		transition:
			transform 0.25s ease,
			background-color 0.25s ease;
	}

	.gallery :global(.gallery-slider__dot.is-active) {
		background: var(--brand-marrone);
		transform: scale(1.25);
	}

	@media (max-width: 768px) {
		.gallery {
			height: auto;
			min-height: 100svh;
			max-height: none;
			overflow: visible;
		}

		.gallery__inner {
			padding: 5.5rem 0.85rem 2.5rem;
			justify-content: flex-start;
		}

		.gallery :global(.gallery-slider__stage) {
			grid-template-columns: minmax(0, 1fr);
			gap: 0;
		}

		.gallery :global(.gallery-slider__nav) {
			position: absolute;
			z-index: 2;
			top: 50%;
			transform: translateY(-50%);
			width: 2.5rem;
			height: 2.5rem;
			display: grid;
			place-items: center;
			background: rgba(249, 246, 238, 0.82);
			font-size: 1.15rem;
		}

		.gallery :global(.gallery-slider__nav--prev) {
			left: 0.35rem;
		}

		.gallery :global(.gallery-slider__nav--next) {
			right: 0.35rem;
		}

		.gallery :global(.gallery-slider__grid) {
			grid-template-columns: 1fr 1fr;
			height: auto;
			gap: 0.4rem;
		}

		.gallery :global(.gallery-slider__stack) {
			display: contents;
		}

		.gallery :global(.gallery-slider__cell),
		.gallery :global(.gallery-slider__stack .gallery-slider__cell) {
			aspect-ratio: 3 / 4;
			height: auto;
			min-height: 0;
		}
	}
</style>
