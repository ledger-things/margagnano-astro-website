---
import Reveal from '../Reveal.tsx';
import I18n from '../I18n.astro';
import { roomsPage, suites } from '../../data/rooms';
import { roomsEn } from '../../data/rooms.en';

const { suitesSection } = roomsPage;
---

<section class="rooms-suites" aria-labelledby="rooms-suites-title">
	<div class="rooms-suites__texture" aria-hidden="true"></div>

	<div class="rooms-suites__inner">
		<Reveal client:visible inView delay={0.06} y={18} duration={0.9} className="rooms-suites__eyebrow-wrap">
			<p id="rooms-suites-title" class="rooms-suites__eyebrow">{suitesSection.eyebrow}</p>
		</Reveal>

		<div class="rooms-suites__list">
			{
				suites.map((suite, i) => {
					const flipped = i % 2 === 1;
					return (
						<article
							class:list={['rooms-suites__block', flipped && 'is-flipped']}
							aria-labelledby={`suite-${suite.slug}-title`}
						>
							<div class="rooms-suites__media">
								<Reveal
									client:visible
									inView
									delay={0.1}
									x={flipped ? 28 : -28}
									y={0}
									duration={1.1}
								>
									<img
										src={suite.highlightImage}
										alt=""
										width="720"
										height="900"
										loading="lazy"
									/>
								</Reveal>
							</div>

							<div class="rooms-suites__copy">
								<Reveal client:visible inView delay={0.12} y={24} duration={1}>
									<h3 id={`suite-${suite.slug}-title`} class="rooms-suites__name">
										{suite.name}
									</h3>
								</Reveal>
								{
									suite.headline && (
										<Reveal client:visible inView delay={0.18} y={18} duration={0.95}>
											<p class="rooms-suites__headline">
												<I18n
													it={suite.headline}
													en={roomsEn[suite.slug]?.headline ?? suite.headline}
												/>
											</p>
										</Reveal>
									)
								}
								<Reveal client:visible inView delay={0.24} y={20} duration={1}>
									<div class="rooms-suites__text">
										{suite.description.map((paragraph, pi) => (
											<I18n
												as="p"
												it={paragraph}
												en={roomsEn[suite.slug]?.description[pi] ?? paragraph}
											/>
										))}
									</div>
								</Reveal>
								{
									suite.highlights && suite.highlights.length > 0 && (
										<Reveal client:visible inView delay={0.3} y={16} duration={0.95}>
											<dl class="rooms-suites__highlights">
												{suite.highlights.map((item) => (
													<div class="rooms-suites__stat">
														<dt class="rooms-suites__stat-value">{item.value}</dt>
														<dd class="rooms-suites__stat-label">{item.label}</dd>
													</div>
												))}
											</dl>
										</Reveal>
									)
								}
								<Reveal client:visible inView delay={0.36} y={14} duration={0.9}>
									<a class="rooms-suites__cta" href={`/suites/${suite.slug}`}>
										Discover {suite.name} <span aria-hidden="true">→</span>
									</a>
								</Reveal>
							</div>
						</article>
					);
				})
			}
		</div>
	</div>
</section>

<style>
	.rooms-suites {
		position: relative;
		isolation: isolate;
		overflow-x: clip;
		background: #f3efe8;
		color: var(--brand-marrone);
	}

	.rooms-suites__texture {
		position: absolute;
		inset: 0;
		z-index: 0;
		background-image: url('/images/home/masseria-texture.png');
		background-size: cover;
		background-position: center;
		opacity: 0.42;
		pointer-events: none;
	}

	.rooms-suites__inner {
		position: relative;
		z-index: 1;
		max-width: 90rem;
		margin: 0 auto;
		padding: clamp(3.75rem, 7vw, 6rem) clamp(1.5rem, 5.5vw, 5.75rem) clamp(4.5rem, 8vw, 7rem);
	}

	.rooms-suites :global(.rooms-suites__eyebrow-wrap) {
		width: 100%;
	}

	.rooms-suites__eyebrow {
		display: flex;
		align-items: center;
		gap: 1rem;
		width: 100%;
		margin: 0;
		font-family: 'Times Sans Serif', sans-serif;
		font-size: 24px;
		letter-spacing: 0.28em;
		text-transform: uppercase;
		color: var(--brand-verde);
	}

	.rooms-suites__eyebrow::after {
		content: '';
		flex: 1 1 auto;
		height: 1px;
		background: var(--brand-terracotta);
	}

	.rooms-suites__list {
		display: grid;
		gap: clamp(4rem, 8vw, 6.5rem);
		margin-top: clamp(2.5rem, 5vw, 4rem);
	}

	.rooms-suites__block {
		display: grid;
		grid-template-columns: minmax(0, 0.92fr) minmax(0, 1.08fr);
		gap: clamp(1.75rem, 5vw, 5rem);
		align-items: center;
	}

	.rooms-suites__block.is-flipped {
		grid-template-columns: minmax(0, 1.08fr) minmax(0, 0.92fr);
	}

	.rooms-suites__block.is-flipped .rooms-suites__media {
		order: 2;
	}

	.rooms-suites__media,
	.rooms-suites__copy {
		min-width: 0;
	}

	.rooms-suites__media {
		width: 100%;
		max-width: 28rem;
		aspect-ratio: 4 / 5;
		overflow: hidden;
		background: #d9d0c4;
	}

	.rooms-suites__block.is-flipped .rooms-suites__media {
		max-width: 28rem;
		justify-self: end;
	}

	.rooms-suites__media :global(div) {
		width: 100%;
		height: 100%;
	}

	.rooms-suites__media img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.rooms-suites__copy {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		max-width: 36rem;
	}

	.rooms-suites__name {
		margin: 0;
		font-family: 'Times Sans Serif', sans-serif;
		font-weight: 400;
		font-size: clamp(1.15rem, 1.8vw, 1.45rem);
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--brand-terracotta);
	}

	.rooms-suites__headline {
		margin: 0.45rem 0 0;
		font-family: 'Cardo', serif;
		font-style: italic;
		font-size: clamp(1.45rem, 2.4vw, 2.05rem);
		line-height: 1.25;
		color: var(--brand-verde);
	}

	.rooms-suites__text {
		display: grid;
		gap: 1rem;
		margin-top: 1.25rem;
	}

	.rooms-suites__text p {
		margin: 0;
		font-family: 'Cardo', serif;
		font-size: clamp(0.95rem, 1.08vw, 1.05rem);
		line-height: 1.7;
		color: var(--brand-marrone);
	}

	.rooms-suites__highlights {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: clamp(0.85rem, 1.8vw, 1.5rem);
		width: 100%;
		margin: 1.75rem 0 0;
	}

	.rooms-suites__block:nth-child(even) .rooms-suites__highlights {
		grid-template-columns: repeat(3, minmax(0, 1fr));
	}

	.rooms-suites__stat {
		margin: 0;
	}

	.rooms-suites__stat-value {
		margin: 0;
		font-family: 'Cardo', serif;
		font-size: clamp(1.15rem, 1.7vw, 1.45rem);
		line-height: 1.15;
		color: var(--brand-azzurro);
	}

	.rooms-suites__stat-label {
		margin: 0.3rem 0 0;
		font-family: 'Times Sans Serif', sans-serif;
		font-size: 0.62rem;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--brand-terracotta);
	}

	.rooms-suites__cta {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		margin-top: 1.6rem;
		color: var(--brand-terracotta);
		text-decoration: none;
		font-family: 'Times Sans Serif', sans-serif;
		font-size: 0.68rem;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		transition: opacity 0.2s ease;
	}

	.rooms-suites__block:not(.is-flipped) .rooms-suites__cta {
		align-self: flex-end;
	}

	.rooms-suites__cta:hover,
	.rooms-suites__cta:focus-visible {
		opacity: 0.65;
		outline: none;
	}

	@media (max-width: 900px) {
		.rooms-suites__block,
		.rooms-suites__block.is-flipped {
			grid-template-columns: 1fr;
			gap: 1.5rem;
		}

		.rooms-suites__block.is-flipped .rooms-suites__media {
			order: 0;
			justify-self: stretch;
			max-width: none;
		}

		.rooms-suites__media {
			max-width: none;
			margin: 0 auto;
			aspect-ratio: 4 / 5;
		}

		.rooms-suites__copy {
			max-width: none;
		}

		.rooms-suites__highlights,
		.rooms-suites__block:nth-child(even) .rooms-suites__highlights {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}

		.rooms-suites__block:not(.is-flipped) .rooms-suites__cta {
			align-self: flex-start;
		}
	}
</style>
