---
import Reveal from '../Reveal.tsx';
import { roomsPage } from '../../data/rooms';

const { wholeMasseria } = roomsPage;
---

<section class="rooms-whole" aria-labelledby="rooms-whole-title">
	<div class="rooms-whole__inner">
		<Reveal client:visible inView delay={0.06} y={16} duration={0.9} className="rooms-whole__eyebrow-wrap">
			<p class="rooms-whole__eyebrow">{wholeMasseria.eyebrow}</p>
		</Reveal>

		<div class="rooms-whole__grid">
			<div class="rooms-whole__copy">
				<Reveal client:visible inView delay={0.14} y={24} duration={1}>
					<h2 id="rooms-whole-title" class="rooms-whole__title">{wholeMasseria.title}</h2>
				</Reveal>
				<Reveal client:visible inView delay={0.24} y={18} duration={0.95}>
					<p class="rooms-whole__text">{wholeMasseria.text}</p>
				</Reveal>
			</div>

			<div class="rooms-whole__media">
				<Reveal client:visible inView delay={0.18} x={28} y={0} duration={1.1}>
					<img
						src={wholeMasseria.image}
						alt={wholeMasseria.imageAlt}
						width="1444"
						height="856"
						loading="lazy"
					/>
				</Reveal>
			</div>
		</div>
	</div>
</section>

<style>
	.rooms-whole {
		overflow-x: clip;
		background: #f6f3ed;
		color: var(--brand-marrone);
	}

	.rooms-whole__inner {
		max-width: 90rem;
		margin: 0 auto;
		padding: clamp(3.75rem, 7vw, 6rem) clamp(1.5rem, 5.5vw, 5.75rem) clamp(4.5rem, 8vw, 7rem);
	}

	.rooms-whole :global(.rooms-whole__eyebrow-wrap) {
		width: 100%;
	}

	.rooms-whole__eyebrow {
		display: flex;
		align-items: center;
		gap: 1rem;
		width: 100%;
		margin: 0;
		font-family: 'Times Sans Serif', sans-serif;
		font-size: 24px;
		letter-spacing: 0.28em;
		text-transform: uppercase;
		color: var(--brand-verde);
	}

	.rooms-whole__eyebrow::after {
		content: '';
		flex: 1 1 auto;
		height: 1px;
		background: var(--brand-terracotta);
	}

	.rooms-whole__grid {
		display: grid;
		grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.15fr);
		gap: clamp(2rem, 5vw, 5rem);
		align-items: center;
		margin-top: clamp(1.75rem, 3.5vw, 2.75rem);
	}

	.rooms-whole__copy,
	.rooms-whole__media {
		min-width: 0;
	}

	.rooms-whole__copy {
		max-width: 32rem;
	}

	.rooms-whole__title {
		margin: 0;
		max-width: 12ch;
		font-family: 'Times Sans Serif', sans-serif;
		font-weight: 400;
		font-size: clamp(1.7rem, 3.4vw, 2.85rem);
		letter-spacing: 0.04em;
		text-transform: uppercase;
		line-height: 1.12;
		color: var(--brand-terracotta);
	}

	.rooms-whole__text {
		margin: 1.35rem 0 0;
		font-family: 'New Caledonia LT Std', serif;
		font-size: clamp(0.98rem, 1.12vw, 1.08rem);
		line-height: 1.7;
		color: var(--brand-marrone);
	}

	.rooms-whole__media {
		width: 100%;
		aspect-ratio: 3 / 2;
		overflow: hidden;
		background: #d9d0c4;
	}

	.rooms-whole__media :global(div) {
		width: 100%;
		height: 100%;
	}

	.rooms-whole__media img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: 18% 70%;
	}

	@media (max-width: 900px) {
		.rooms-whole__grid {
			grid-template-columns: 1fr;
			gap: 1.75rem;
		}

		.rooms-whole__copy {
			max-width: none;
		}

		.rooms-whole__title {
			max-width: none;
		}
	}
</style>
