---
import Reveal from '../Reveal.tsx';
import I18n from '../I18n.astro';
import { formatRoomSpecValue, type Room } from '../../data/rooms';
import { roomsEn } from '../../data/rooms.en';
import './RoomDetails.css';

interface Props {
	room: Room;
}

const { room } = Astro.props;
const en = roomsEn[room.slug];
---

<section class="room-details" aria-labelledby="room-details-title">
	<div class="room-details__inner">
		<hr class="room-details__rule" />

		<div class="room-details__content">
			<Reveal client:visible inView delay={0.08} y={22} duration={1}>
				<h2 id="room-details-title" class="room-details__title">{room.name}</h2>
			</Reveal>

			<Reveal client:visible inView delay={0.18} y={20} duration={1}>
				<div class="room-details__text">
					{room.description.map((paragraph, i) => (
						<I18n as="p" it={paragraph} en={en?.description[i] ?? paragraph} />
					))}
				</div>
			</Reveal>

			<div class="room-details__specs">
				{
					room.specs.map((spec, i) => {
						const enSpec = en?.specs[spec.key];
						const itValue = formatRoomSpecValue(spec);
						const enValue = enSpec
							? formatRoomSpecValue({ ...spec, label: enSpec.label, details: enSpec.details ?? spec.details })
							: itValue;
						return (
							<Reveal
								client:visible
								inView
								delay={0.28 + i * 0.06}
								y={18}
								duration={0.95}
								className="room-details__spec"
							>
								<p class="room-details__label">
									<I18n it={spec.label} en={enSpec?.label ?? spec.label} />
								</p>
								<p class="room-details__value">
									<I18n it={itValue} en={enValue} />
								</p>
							</Reveal>
						);
					})
				}
			</div>
		</div>

		<hr class="room-details__rule" />
	</div>
</section>
