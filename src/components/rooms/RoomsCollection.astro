---
import Reveal from '../Reveal.tsx';
import RoomsCarousel from './RoomsCarousel.tsx';
import { roomsPage } from '../../data/rooms';

const { roomsCarousel } = roomsPage;
---

<section class="rooms-collection" aria-labelledby="rooms-collection-title">
	<div class="rooms-collection__head">
		<Reveal client:visible inView delay={0.06} y={20} duration={0.95}>
			<p class="rooms-collection__eyebrow">{roomsCarousel.eyebrow}</p>
		</Reveal>
		<Reveal client:visible inView delay={0.16} y={24} duration={1}>
			<h2 id="rooms-collection-title" class="rooms-collection__title">{roomsCarousel.title}</h2>
		</Reveal>
	</div>

	<Reveal client:visible inView delay={0.22} y={28} duration={1.05} className="rooms-collection__carousel">
		<RoomsCarousel client:visible />
	</Reveal>
</section>

<style>
	.rooms-collection {
		overflow-x: clip;
		background: #f6f3ed;
		color: var(--brand-marrone);
		padding: clamp(3.5rem, 7vw, 5.75rem) 0 clamp(4.5rem, 8vw, 7rem);
	}

	.rooms-collection__head {
		max-width: 90rem;
		margin: 0 auto;
		padding: 0 clamp(1.5rem, 5.5vw, 5.75rem);
	}

	.rooms-collection__eyebrow {
		display: flex;
		align-items: center;
		gap: 0.85rem;
		margin: 0;
		font-family: 'Times Sans Serif', sans-serif;
		font-size: 24px;
		letter-spacing: 0.28em;
		text-transform: uppercase;
		color: var(--brand-verde);
	}

	.rooms-collection__eyebrow::after {
		content: '';
		flex: 0 0 3.25rem;
		width: 3.25rem;
		height: 1px;
		background: var(--brand-terracotta);
	}

	.rooms-collection__title {
		margin: 0.9rem 0 0;
		max-width: 18ch;
		font-family: 'Times Sans Serif', sans-serif;
		font-weight: 400;
		font-size: clamp(1.7rem, 3.4vw, 2.85rem);
		letter-spacing: 0.04em;
		text-transform: uppercase;
		line-height: 1.12;
		color: var(--brand-terracotta);
	}

	.rooms-collection :global(.rooms-collection__carousel) {
		margin-top: clamp(2.25rem, 4.5vw, 3.5rem);
	}

	.rooms-collection :global(.rooms-carousel) {
		position: relative;
		display: grid;
		grid-template-columns: auto minmax(0, 1fr);
		align-items: start;
		gap: clamp(0.75rem, 1.6vw, 1.25rem);
		padding-left: clamp(1.5rem, 5.5vw, 5.75rem);
	}

	.rooms-collection :global(.rooms-carousel__arrow) {
		display: grid;
		place-items: center;
		width: 2.6rem;
		height: 2.6rem;
		margin-top: calc((clamp(14.5rem, 22vw, 18rem) * 5 / 4) / 2 - 1.3rem);
		padding: 0;
		border: 1px solid var(--brand-terracotta);
		border-radius: 50%;
		background: transparent;
		color: var(--brand-terracotta);
		font-size: 1rem;
		line-height: 1;
		cursor: pointer;
		transition:
			opacity 0.2s ease,
			background-color 0.2s ease,
			color 0.2s ease;
	}

	.rooms-collection :global(.rooms-carousel__arrow:hover),
	.rooms-collection :global(.rooms-carousel__arrow:focus-visible) {
		background: var(--brand-terracotta);
		color: #f6f3ed;
		outline: none;
	}

	.rooms-collection :global(.rooms-carousel__arrow:disabled) {
		opacity: 0.28;
		cursor: default;
		background: transparent;
		color: var(--brand-terracotta);
	}

	.rooms-collection :global(.rooms-carousel__arrow--next) {
		position: absolute;
		top: 0;
		right: clamp(1rem, 3vw, 2rem);
		z-index: 2;
		margin-top: calc((clamp(14.5rem, 22vw, 18rem) * 5 / 4) / 2 - 1.3rem);
	}

	.rooms-collection :global(.rooms-carousel__viewport) {
		min-width: 0;
		overflow-x: auto;
		scroll-snap-type: x mandatory;
		overscroll-behavior-x: contain;
		scrollbar-width: none;
		-ms-overflow-style: none;
	}

	.rooms-collection :global(.rooms-carousel__viewport::-webkit-scrollbar) {
		display: none;
	}

	.rooms-collection :global(.rooms-carousel__track) {
		display: flex;
		gap: clamp(1.1rem, 2vw, 1.75rem);
		width: max-content;
		padding-right: clamp(1.5rem, 5.5vw, 5.75rem);
	}

	.rooms-collection :global(.rooms-carousel__card) {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		flex: 0 0 clamp(14.5rem, 22vw, 18rem);
		scroll-snap-align: start;
	}

	.rooms-collection :global(.rooms-carousel__figure) {
		margin: 0;
		width: 100%;
		aspect-ratio: 4 / 5;
		overflow: hidden;
		background: #d9d0c4;
	}

	.rooms-collection :global(.rooms-carousel__figure img) {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center;
	}

	.rooms-collection :global(.rooms-carousel__name) {
		margin: 1.05rem 0 0;
		font-family: 'Times Sans Serif', sans-serif;
		font-weight: 400;
		font-size: clamp(1.05rem, 1.4vw, 1.25rem);
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--brand-terracotta);
	}

	.rooms-collection :global(.rooms-carousel__meta) {
		margin: 0.35rem 0 0;
		font-family: 'New Caledonia LT Std', serif;
		font-style: italic;
		font-size: 0.92rem;
		line-height: 1.3;
		color: var(--brand-marrone);
	}

	.rooms-collection :global(.rooms-carousel__excerpt) {
		margin: 0.7rem 0 0;
		font-family: 'New Caledonia LT Std', serif;
		font-size: 0.92rem;
		line-height: 1.55;
		color: var(--brand-marrone);
	}

	.rooms-collection :global(.rooms-carousel__cta) {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		margin: 1.1rem 0 0 auto;
		color: var(--brand-terracotta);
		text-decoration: none;
		font-family: 'Times Sans Serif', sans-serif;
		font-size: 0.68rem;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		transition: opacity 0.2s ease;
	}

	.rooms-collection :global(.rooms-carousel__cta:hover),
	.rooms-collection :global(.rooms-carousel__cta:focus-visible) {
		opacity: 0.65;
		outline: none;
	}

	@media (max-width: 700px) {
		.rooms-collection :global(.rooms-carousel) {
			grid-template-columns: auto minmax(0, 1fr);
			padding-left: 1.15rem;
		}

		.rooms-collection :global(.rooms-carousel__arrow--next) {
			right: 0.75rem;
		}

		.rooms-collection :global(.rooms-carousel__card) {
			flex-basis: min(78vw, 18rem);
		}
	}
</style>
