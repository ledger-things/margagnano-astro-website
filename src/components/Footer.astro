---
// Footer: sfondo verde, logo bianco e informazioni di contatto.
import Reveal from './Reveal.tsx';
import I18n from './I18n.astro';

interface Props {
	homeHref?: string;
}

const { homeHref = '/home' } = Astro.props;
---

<footer class="footer">
	<div class="footer__inner">
		<div class="footer__main">
			<Reveal client:visible inView delay={0.05}>
				<a class="footer__brand" href={homeHref} aria-label="Masseria Margagnano - Home">
					<img
						class="footer__logo"
						src="/logo/logo-full-white.svg"
						alt="Masseria Margagnano"
						width="628"
						height="387"
					/>
				</a>
			</Reveal>

			<Reveal client:visible inView delay={0.15}>
				<address class="footer__address">
					<span class="footer__address-name">Masseria Margagnano</span>
					<span>Strada Comunale Burgo Cerasina</span>
					<span>72015 Fasano, Brindisi, Italy</span>
					<a
						class="footer__social"
						href="https://www.instagram.com/masseriamargagnano/"
						target="_blank"
						rel="noopener noreferrer"
						aria-label="Instagram – @masseriamargagnano"
					>
						<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
							<rect x="3" y="3" width="18" height="18" rx="5" fill="none" stroke="currentColor" stroke-width="1.4" />
							<circle cx="12" cy="12" r="4.2" fill="none" stroke="currentColor" stroke-width="1.4" />
							<circle cx="17.4" cy="6.6" r="1" fill="currentColor" />
						</svg>
						<span>@masseriamargagnano</span>
					</a>
				</address>
			</Reveal>
		</div>

		<div class="footer__divider" aria-hidden="true"></div>

		<div class="footer__bottom">
			<p class="footer__collection">
				<I18n it="Parte della " en="Part of the " />
				<a
					href="https://www.dominiquedebayprivateretreats.com/masseria-margagnano-puglia-italy"
					target="_blank"
					rel="noopener noreferrer"
				>
					Dominique Debay Collection
				</a>
			</p>
			<p class="footer__copy">&copy; 2026 Masseria Margagnano</p>
		</div>
	</div>
</footer>

<style>
	.footer {
		background-color: var(--brand-verde);
		color: var(--brand-avorio);
		width: 100%;
	}

	.footer__inner {
		max-width: 90rem;
		margin: 0 auto;
		padding: clamp(2.5rem, 5vw, 4rem) clamp(1.5rem, 5vw, 5rem);
	}

	.footer__main {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: clamp(2rem, 5vw, 4rem);
		flex-wrap: wrap;
	}

	.footer__brand {
		display: inline-flex;
		flex-shrink: 0;
	}

	.footer__logo {
		height: clamp(72px, 9vw, 120px);
		width: auto;
	}

	.footer__address {
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
		font-family: 'Cardo', serif;
		font-weight: 400;
		font-style: normal;
		font-size: clamp(0.95rem, 1.2vw, 1.05rem);
		line-height: 1.5;
		text-align: right;
		opacity: 0.92;
	}

	.footer__address-name {
		font-size: 1.15em;
		letter-spacing: 0.02em;
		margin-bottom: 0.15rem;
	}

	.footer__divider {
		height: 1px;
		width: 100%;
		margin: clamp(1.75rem, 3vw, 2.5rem) 0 clamp(1.25rem, 2vw, 1.75rem);
		background-color: color-mix(in srgb, var(--brand-avorio) 30%, transparent);
	}

	.footer__social {
		display: inline-flex;
		align-items: center;
		justify-content: flex-end;
		gap: 0.5rem;
		margin-top: 0.85rem;
		color: inherit;
		text-decoration: none;
		transition: opacity 0.2s ease;
	}

	.footer__social:hover,
	.footer__social:focus-visible,
	.footer__collection a:hover,
	.footer__collection a:focus-visible {
		opacity: 0.65;
		outline: none;
	}

	.footer__bottom {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		flex-wrap: wrap;
	}

	.footer__collection {
		margin: 0;
		font-family: 'Cardo', serif;
		font-weight: 400;
		font-size: clamp(0.7rem, 0.9vw, 0.8rem);
		letter-spacing: 0.18em;
		text-transform: uppercase;
		opacity: 0.85;
	}

	.footer__collection a {
		color: inherit;
		text-decoration: underline;
		text-underline-offset: 0.25em;
		text-decoration-thickness: 1px;
		transition: opacity 0.2s ease;
	}

	.footer__copy {
		margin: 0;
		font-family: 'Cardo', serif;
		font-weight: 400;
		font-size: clamp(0.7rem, 0.9vw, 0.8rem);
		letter-spacing: 0.18em;
		text-transform: uppercase;
		text-align: right;
		opacity: 0.85;
	}

	@media (max-width: 640px) {
		.footer__main {
			flex-direction: column;
			align-items: center;
			text-align: center;
			gap: 1.75rem;
		}

		.footer__address {
			text-align: center;
		}

		.footer__social {
			justify-content: center;
		}

		.footer__bottom {
			flex-direction: column;
			text-align: center;
		}

		.footer__copy {
			text-align: center;
		}
	}
</style>
