---
import SiteHeader from './SiteHeader.tsx';

interface Props {
	tone?: 'auto' | 'light';
	homeHref?: string;
}

const { tone = 'auto', homeHref = '/home' } = Astro.props;
---

<SiteHeader client:load tone={tone} currentPath={Astro.url.pathname} homeHref={homeHref} />

<style is:global>
	.site-header {
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		z-index: 80;
		width: 100%;
		background: transparent;
		transition:
			background-color 0.35s ease,
			box-shadow 0.35s ease,
			backdrop-filter 0.35s ease;
	}

	.site-header.is-scrolled {
		background: var(--brand-cream);
		box-shadow: 0 1px 0 rgba(107, 90, 68, 0.08);
	}

	.site-header__nav {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
		align-items: center;
		gap: clamp(0.75rem, 2vw, 2rem);
		width: 100%;
		margin: 0 auto;
		padding: clamp(0.85rem, 2vh, 1.35rem) clamp(1.25rem, 3.5vw, 3.5rem);
		transition: padding 0.35s ease;
	}

	.site-header.is-scrolled .site-header__nav {
		padding-block: 0.65rem;
	}

	.site-header__brand {
		display: grid;
		place-items: center;
		position: relative;
		z-index: 2;
	}

	.site-header__logo {
		display: block;
		grid-area: 1 / 1;
		width: auto;
		transition:
			opacity 0.3s ease,
			height 0.35s ease,
			filter 0.3s ease;
	}

	.site-header__logo--light {
		height: clamp(4.5rem, 8vw, 15.5rem);
		filter: drop-shadow(0 1px 8px rgba(0, 0, 0, 0.35));
		opacity: 1;
	}

	.site-header__logo--dark {
		height: clamp(3.25rem, 5.5vw, 12.5rem);
		opacity: 0;
	}

	.site-header.is-scrolled .site-header__logo--light,
	.site-header.is-menu-open .site-header__logo--light {
		opacity: 0;
		height: clamp(3.25rem, 5.5vw, 4.5rem);
	}

	.site-header.is-scrolled .site-header__logo--dark,
	.site-header.is-menu-open .site-header__logo--dark {
		opacity: 1;
	}

	.site-header__side {
		display: flex;
		align-items: center;
		min-width: 0;
	}

	.site-header__side--left {
		justify-content: flex-start;
	}

	.site-header__side--right {
		justify-content: flex-end;
	}

	.site-header__links {
		display: flex;
		flex-direction: row;
		flex-wrap: nowrap;
		align-items: center;
		gap: clamp(0.85rem, 1.8vw, 1.75rem);
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.site-header__links a {
		display: inline-block;
		color: rgba(255, 255, 255, 0.85);
		text-decoration: none;
		font-family: 'Times Sans Serif', sans-serif;
		font-weight: 400;
		font-style: normal;
		font-size: 16px;
		line-height: 100%;
		letter-spacing: 0;
		white-space: nowrap;
		text-shadow: 0 1px 10px rgba(0, 0, 0, 0.28);
		transition: color 0.25s ease, opacity 0.2s ease;
	}

	.site-header.is-scrolled .site-header__links a {
		color: #6b5a44;
		text-shadow: none;
	}

	.site-header__links a.is-active,
	.site-header.is-scrolled .site-header__links a.is-active {
		color: var(--brand-terracotta);
	}

	.site-header__links a:hover,
	.site-header__links a:focus-visible {
		opacity: 0.65;
		outline: none;
	}

	.site-header__lang {
		display: inline-flex;
		align-items: center;
		gap: 0.2rem;
	}

	.site-header__lang-btn {
		appearance: none;
		border: 0;
		background: transparent;
		padding: 0;
		cursor: pointer;
		color: rgba(255, 255, 255, 0.45);
		font-family: 'Times Sans Serif', sans-serif;
		font-weight: 400;
		font-style: normal;
		font-size: 16px;
		line-height: 100%;
		letter-spacing: 0;
		text-shadow: 0 1px 10px rgba(0, 0, 0, 0.28);
		transition: color 0.2s ease, opacity 0.2s ease;
	}

	.site-header__lang-btn.is-active {
		color: rgba(255, 255, 255, 0.9);
	}

	.site-header__lang-sep {
		color: rgba(255, 255, 255, 0.45);
		font-family: 'Times Sans Serif', sans-serif;
		font-weight: 400;
		font-size: 16px;
		line-height: 100%;
		letter-spacing: 0;
		text-shadow: 0 1px 10px rgba(0, 0, 0, 0.28);
	}

	.site-header.is-scrolled .site-header__lang-btn {
		color: rgba(107, 90, 68, 0.4);
		text-shadow: none;
	}

	.site-header.is-scrolled .site-header__lang-btn.is-active {
		color: #6b5a44;
	}

	.site-header.is-scrolled .site-header__lang-sep {
		color: rgba(107, 90, 68, 0.4);
		text-shadow: none;
	}

	.site-header__lang-btn:hover,
	.site-header__lang-btn:focus-visible {
		opacity: 0.7;
		outline: none;
	}

	.site-header__toggle {
		display: none;
		position: relative;
		z-index: 2;
		appearance: none;
		border: 0;
		background: transparent;
		width: 2.75rem;
		height: 2.75rem;
		padding: 0;
		cursor: pointer;
		justify-self: end;
		align-items: center;
		justify-content: center;
	}

	.site-header__toggle-lines {
		display: flex;
		flex-direction: column;
		justify-content: center;
		gap: 0.35rem;
		width: 1.35rem;
	}

	.site-header__toggle-lines span {
		display: block;
		height: 1.5px;
		width: 100%;
		background: rgba(255, 255, 255, 0.9);
		transition:
			transform 0.3s ease,
			opacity 0.3s ease,
			background-color 0.3s ease;
		transform-origin: center;
	}

	.site-header.is-scrolled .site-header__toggle-lines span,
	.site-header.is-menu-open .site-header__toggle-lines span {
		background: #6b5a44;
	}

	.site-header.is-menu-open .site-header__toggle-lines span:nth-child(1) {
		transform: translateY(0.425rem) rotate(45deg);
	}

	.site-header.is-menu-open .site-header__toggle-lines span:nth-child(2) {
		opacity: 0;
	}

	.site-header.is-menu-open .site-header__toggle-lines span:nth-child(3) {
		transform: translateY(-0.425rem) rotate(-45deg);
	}

	.site-header__drawer {
		position: fixed;
		inset: 0;
		z-index: 1;
		display: grid;
		grid-template-columns: 1fr;
	}

	.site-header__drawer-backdrop {
		position: absolute;
		inset: 0;
		border: 0;
		padding: 0;
		background: rgba(40, 34, 28, 0.35);
		cursor: pointer;
	}

	.site-header__drawer-panel {
		position: relative;
		z-index: 2;
		display: flex;
		flex-direction: column;
		margin-left: auto;
		width: min(100%, 22rem);
		height: 100%;
		background: var(--brand-cream);
		padding: 6.5rem 1.75rem 2rem;
		box-shadow: -12px 0 40px rgba(0, 0, 0, 0.12);
		overflow-y: auto;
	}

	.site-header__drawer-lang {
		margin-top: auto;
		padding-top: 1.25rem;
		border-top: 1px solid rgba(107, 90, 68, 0.12);
		display: flex;
		justify-content: flex-end;
	}

	.site-header__drawer-lang .site-header__lang-btn,
	.site-header__drawer-lang .site-header__lang-sep {
		color: rgba(107, 90, 68, 0.4);
		text-shadow: none;
		font-size: 1.05rem;
	}

	.site-header__drawer-lang .site-header__lang-btn.is-active {
		color: #6b5a44;
	}

	.site-header__drawer-links {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.site-header__drawer-links a {
		display: block;
		padding: 0.95rem 0.15rem;
		border-bottom: 1px solid rgba(107, 90, 68, 0.12);
		color: #6b5a44;
		text-decoration: none;
		font-family: 'Times Sans Serif', sans-serif;
		font-size: 1.15rem;
		letter-spacing: 0.03em;
		transition: opacity 0.2s ease;
	}

	.site-header__drawer-links a.is-active {
		color: var(--brand-terracotta);
	}

	.site-header__drawer-links a:hover,
	.site-header__drawer-links a:focus-visible {
		opacity: 0.65;
		outline: none;
	}

	@media (max-width: 1280px) {
		.site-header__links {
			gap: 0.7rem;
		}
	}

	@media (max-width: 960px) {
		.site-header__side {
			display: none;
		}

		.site-header__nav {
			grid-template-columns: 2.75rem 1fr 2.75rem;
			padding: 0.75rem 1rem;
		}

		.site-header__brand {
			justify-self: center;
		}

		.site-header__toggle {
			display: inline-flex;
			grid-column: 3;
		}

		.site-header__logo--light {
			height: 3.5rem;
		}

		.site-header__logo--dark {
			height: 3rem;
		}

		.site-header.is-menu-open {
			background: var(--brand-cream);
		}
	}
</style>
