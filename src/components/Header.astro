---
// Header con logo centrale. I link verranno aggiunti in seguito.
import Reveal from './Reveal.tsx';
---

<header class="site-header">
	<nav class="site-header__nav" aria-label="Navigazione principale">
		<div class="site-header__side site-header__side--left">
			<!-- Link di navigazione (sinistra) -->
		</div>

		<a class="site-header__brand" href="/" aria-label="Masseria Margagnano - Home">
			<Reveal client:load delay={0.1} y={-16} duration={1}>
				<img
					src="/images/logo-margagnano-white.png"
					alt="Masseria Margagnano"
					class="site-header__logo"
					width="1024"
					height="724"
				/>
			</Reveal>
		</a>

		<div class="site-header__side site-header__side--right">
			<!-- Link di navigazione (destra) -->
		</div>
	</nav>
</header>

<style>
	.site-header {
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		z-index: 50;
		width: 100%;
	}

	.site-header__nav {
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		align-items: center;
		gap: 1rem;
		max-width: 90rem;
		margin: 0 auto;
		padding: 1.25rem 1.5rem;
	}

	.site-header__brand {
		display: inline-flex;
		justify-content: center;
		align-items: center;
	}

	.site-header__logo {
		height: 88px;
		width: auto;
		filter: drop-shadow(0 1px 8px rgba(0, 0, 0, 0.35));
	}

	.site-header__side {
		display: flex;
		align-items: center;
	}

	.site-header__side--right {
		justify-content: flex-end;
	}

	@media (max-width: 640px) {
		.site-header__nav {
			padding: 0.875rem 1rem;
		}

		.site-header__logo {
			height: 64px;
		}
	}
</style>
