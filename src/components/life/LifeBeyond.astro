---
import Reveal from '../Reveal.tsx';
import I18n from '../I18n.astro';

const partners = [
	{ name: 'Cala Cimì', logo: '/images/partners/calacimi.png' },
	{ name: 'Indigenus', logo: '/images/partners/indigenus.png' },
	{ name: 'Serri', logo: '/images/partners/serri.svg' },
];
---

<section class="life-beyond" aria-labelledby="beyond-title">
	<div class="life-beyond__texture" aria-hidden="true"></div>

	<div class="life-beyond__inner">
		<Reveal client:visible inView delay={0.1} y={28} duration={1.75}>
			<h2 id="beyond-title" class="life-beyond__title">Beyond Margagnano</h2>
		</Reveal>

		<Reveal client:visible inView delay={0.25} y={32} duration={1.8}>
			<p class="life-beyond__text">
				<I18n
					it="Margagnano è il punto di partenza per esplorare un territorio ricco di storia, natura e cultura. Una selezione di luoghi scelti con cura accompagna gli ospiti alla scoperta della Puglia più autentica, creando un percorso che si estende oltre la masseria e ne riflette gli stessi valori di equilibrio, bellezza e autenticità."
					en="Margagnano is a starting point for a land rich in history, nature and culture. A carefully chosen selection of places accompanies guests into a more authentic Puglia, extending beyond the masseria and reflecting the same values of balance, beauty and authenticity."
				/>
			</p>
		</Reveal>

		<Reveal client:visible inView delay={0.35} y={24} duration={1.7}>
			<p class="life-beyond__label">
				<I18n it="Le partnership" en="Partnerships" />
			</p>
		</Reveal>

		<div class="life-beyond__grid" role="list">
			{
				partners.map((partner, i) => (
					<Reveal client:visible inView delay={0.4 + i * 0.12} y={36} duration={1.8}>
						<figure class="life-beyond__card" role="listitem">
							<img src={partner.logo} alt={partner.name} loading="lazy" />
						</figure>
					</Reveal>
				))
			}
		</div>
	</div>
</section>

<style>
	.life-beyond {
		position: relative;
		isolation: isolate;
		overflow-x: clip;
		background: #f3efe8;
		color: #4a3f34;
		padding: clamp(4.5rem, 9vw, 7.5rem) 0 clamp(4rem, 8vw, 6.5rem);
	}

	.life-beyond__texture {
		position: absolute;
		inset: 0;
		z-index: 0;
		background-image: url('/images/home/masseria-texture.png');
		background-size: cover;
		background-position: center;
		opacity: 0.4;
		pointer-events: none;
	}

	.life-beyond__inner {
		position: relative;
		z-index: 1;
		display: flex;
		flex-direction: column;
		align-items: center;
		max-width: 92rem;
		margin: 0 auto;
		padding-inline: clamp(1.25rem, 5vw, 5.5rem);
		text-align: center;
	}

	.life-beyond__title {
		margin: 0;
		font-family: 'Cardo', serif;
		font-weight: 400;
		font-size: clamp(1.85rem, 3.2vw, 2.75rem);
		letter-spacing: 0.06em;
		text-transform: uppercase;
		line-height: 1.15;
		color: var(--brand-terracotta);
	}

	.life-beyond__text {
		margin: clamp(1.75rem, 3.5vw, 2.5rem) 0 0;
		max-width: 46rem;
		font-family: 'Cardo', serif;
		font-size: clamp(1.05rem, 1.35vw, 1.2rem);
		line-height: 1.65;
		color: #4a3f34;
	}

	.life-beyond__label {
		margin: clamp(2.75rem, 5.5vw, 4rem) 0 0;
		font-family: 'Cardo', serif;
		font-size: clamp(1.15rem, 1.5vw, 1.35rem);
		line-height: 1.3;
		color: #4a3f34;
	}

	.life-beyond__grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: clamp(1.5rem, 4vw, 3.5rem);
		align-items: center;
		width: 100%;
		max-width: 34rem;
		margin-top: clamp(1.75rem, 3.5vw, 2.75rem);
	}

	.life-beyond__grid :global(> *) {
		min-width: 0;
	}

	.life-beyond__card {
		display: flex;
		align-items: center;
		justify-content: center;
		margin: 0;
		width: 100%;
		aspect-ratio: 3 / 2;
	}

	.life-beyond__card img {
		display: block;
		max-width: 100%;
		max-height: 100%;
		object-fit: contain;
		/* alcuni loghi hanno lo sfondo bianco */
		mix-blend-mode: multiply;
	}

	@media (max-width: 560px) {
		.life-beyond__grid {
			grid-template-columns: 1fr;
			max-width: 10rem;
			gap: 2rem;
		}
	}
</style>
