---
import Reveal from '../Reveal.tsx';
---

<section class="life-hero" aria-label="Life in Margagnano">
	<div class="life-hero__media" aria-hidden="true">
		<img
			src="/images/masseria/tabs.jpg"
			alt=""
			width="1920"
			height="1080"
			fetchpriority="high"
		/>
	</div>

	<div class="life-hero__content">
		<Reveal client:load delay={0.2} duration={1.1} y={24}>
			<h1 class="life-hero__title">Life in Margagnano</h1>
		</Reveal>
		<Reveal client:load delay={0.45} duration={0.9} y={16}>
			<button type="button" class="life-hero__play" aria-label="Play video">
				<span class="life-hero__play-icon" aria-hidden="true"></span>
			</button>
		</Reveal>
	</div>
</section>

<style>
	.life-hero {
		position: relative;
		isolation: isolate;
		min-height: 100svh;
		display: grid;
		place-items: center;
		overflow: hidden;
		color: #fff;
		background: #1a1814;
	}

	.life-hero__media {
		position: absolute;
		inset: 0;
		z-index: 0;
	}

	.life-hero__media img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center;
	}

	.life-hero__content {
		position: relative;
		z-index: 1;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: clamp(1.25rem, 3vh, 2rem);
		padding: clamp(6rem, 12vh, 8rem) 1.5rem 2rem;
		text-align: center;
	}

	.life-hero__title {
		margin: 0;
		font-family: 'Cardo', serif;
		font-weight: 400;
		font-size: clamp(2.25rem, 5.5vw, 4.25rem);
		letter-spacing: 0.02em;
		line-height: 1.15;
		color: #fff;
		text-shadow: 0 1px 18px rgba(0, 0, 0, 0.25);
	}

	.life-hero__play {
		display: grid;
		place-items: center;
		width: clamp(3.25rem, 5vw, 4rem);
		height: clamp(3.25rem, 5vw, 4rem);
		padding: 0;
		border: 1.5px solid rgba(255, 255, 255, 0.85);
		border-radius: 50%;
		background: transparent;
		color: #fff;
		cursor: pointer;
		transition:
			background-color 0.25s ease,
			transform 0.25s ease;
	}

	.life-hero__play:hover,
	.life-hero__play:focus-visible {
		background: rgba(255, 255, 255, 0.12);
		outline: none;
		transform: scale(1.05);
	}

	.life-hero__play-icon {
		display: block;
		width: 0;
		height: 0;
		margin-left: 0.2rem;
		border-style: solid;
		border-width: 0.55rem 0 0.55rem 0.9rem;
		border-color: transparent transparent transparent #fff;
	}
</style>
