---
import Reveal from '../Reveal.tsx';
import I18n from '../I18n.astro';
---

<section id="origini" class="mh-origini" aria-labelledby="origini-title">
	<div class="mh-origini__inner">
		<div class="mh-origini__copy">
			<Reveal client:visible inView delay={0.05} y={28}>
				<h2 id="origini-title" class="mh-origini__title">
					<I18n
						it="Cinque secoli di storia, ancora presenti in Masseria"
						en="Five centuries of history, still present in the masseria"
					/>
				</h2>
			</Reveal>
			<Reveal client:visible inView delay={0.18} y={32}>
				<div class="mh-origini__text">
					<I18n
						as="p"
						it="Da oltre cinquecento anni Margagnano appartiene al paesaggio della Puglia. Una masseria che ha costruito nel tempo un'identità ancora riconoscibile."
						en="For more than five hundred years Margagnano has belonged to the landscape of Puglia. A masseria that has built, over time, an identity that is still recognisable."
					/>
					<I18n
						as="p"
						it="La pietra, gli spazi della masseria e gli ulivi raccontano ancora questa storia. Sono 195 gli alberi di ulivo che circondano la proprietà, alcuni dei quali secolari, testimoni silenziosi di generazioni che hanno abitato e coltivato questo territorio."
						en="Stone, the rooms of the masseria and the olive trees still tell this story. One hundred and ninety-five olive trees surround the property, some of them centuries old — silent witnesses to the generations who lived and farmed this land."
					/>
					<I18n
						as="p"
						it="Oggi Margagnano conserva questo legame con le proprie origini, accogliendo una dimensione contemporanea senza perdere il carattere della masseria e il ritmo lento della campagna pugliese."
						en="Today Margagnano keeps this bond with its origins, welcoming a contemporary way of living without losing the character of the masseria or the slow rhythm of the Apulian countryside."
					/>
				</div>
			</Reveal>
		</div>

		<div class="mh-origini__media">
			<Reveal client:visible inView delay={0.2} x={36} y={0} duration={1.05}>
				<img
					src="/images/masseria/origini.jpg"
					alt="Cortile della masseria tra archi e luce pugliese"
					width="1704"
					height="970"
					loading="lazy"
				/>
			</Reveal>
		</div>
	</div>

	<Reveal client:visible inView delay={0.15} y={20} duration={1.1} className="mh-origini__script-wrap">
		<p class="mh-origini__script">The origins reveal what time has preserved.</p>
	</Reveal>
</section>

<style>
	.mh-origini {
		position: relative;
		overflow-x: hidden;
		background: var(--brand-verde);
		color: var(--brand-avorio);
		/* spazio in basso per la script absolute */
		padding-bottom: clamp(7.5rem, 12vw, 10rem);
	}

	.mh-origini__inner {
		display: grid;
		grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.15fr);
		gap: clamp(2rem, 5vw, 4.5rem);
		align-items: center;
		max-width: 90rem;
		margin: 0 auto;
		padding: clamp(4rem, 8vw, 6.5rem) clamp(1.25rem, 5vw, 5rem) clamp(3rem, 6vw, 5rem);
	}

	.mh-origini__title {
		margin: 0 0 1.5rem;
		font-family: 'Times Sans Serif', sans-serif;
		font-weight: 400;
		font-size: clamp(1.85rem, 3.2vw, 2.75rem);
		line-height: 1.1;
		letter-spacing: 0.02em;
		color: var(--brand-avorio);
	}

	.mh-origini__text {
		display: grid;
		gap: 1.1rem;
		max-width: 32rem;
	}

	.mh-origini__text p {
		margin: 0;
		font-family: 'Cardo', serif;
		font-size: clamp(0.98rem, 1.15vw, 1.1rem);
		line-height: 1.65;
		color: rgba(233, 227, 211, 0.95);
	}

	.mh-origini__media {
		width: 100%;
		aspect-ratio: 16 / 10;
		overflow: hidden;
		min-width: 0;
	}

	.mh-origini__media :global(div) {
		width: 100%;
		height: 100%;
	}

	.mh-origini__media img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.mh-origini :global(.mh-origini__script-wrap) {
		position: absolute;
		left: clamp(1.25rem, 5vw, 5rem);
		bottom: clamp(1.25rem, 3vw, 2.25rem);
		z-index: 1;
		max-width: calc(100% - clamp(1.25rem, 5vw, 5rem));
		pointer-events: none;
	}

	.mh-origini__script {
		margin: 0;
		font-family: 'Monsieur La Doulaise', cursive;
		font-weight: 400;
		font-style: normal;
		font-size: 100px;
		line-height: 100px;
		letter-spacing: 0;
		white-space: nowrap;
		color: rgba(233, 227, 211, 0.55);
		text-align: left;
	}

	@media (max-width: 900px) {
		.mh-origini {
			padding-bottom: clamp(5rem, 18vw, 7rem);
		}

		.mh-origini__inner {
			grid-template-columns: 1fr;
			padding-bottom: 1.5rem;
		}

		.mh-origini__media {
			order: -1;
			aspect-ratio: 4 / 3;
		}

		.mh-origini__script {
			font-size: clamp(2.5rem, 12vw, 4rem);
			line-height: 1;
			white-space: normal;
		}
	}
</style>
