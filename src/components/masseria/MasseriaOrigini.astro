---
import Reveal from '../Reveal.tsx';
---

<section id="origini" class="mh-origini" aria-labelledby="origini-title">
	<div class="mh-origini__inner">
		<div class="mh-origini__copy">
			<Reveal client:visible inView delay={0.05} y={28}>
				<h2 id="origini-title" class="mh-origini__title">Le origini della Masseria</h2>
			</Reveal>
			<Reveal client:visible inView delay={0.18} y={32}>
				<div class="mh-origini__text">
					<p>
						Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor
						incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud
						exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat.
					</p>
					<p>
						Duis aute irure dolor in reprehenderit in voluptate velit esse cillum dolore eu fugiat
						nulla pariatur. Excepteur sint occaecat cupidatat non proident, sunt in culpa qui
						officia deserunt mollit anim id est laborum.
					</p>
					<p>
						Sed ut perspiciatis unde omnis iste natus error sit voluptatem accusantium doloremque
						laudantium, totam rem aperiam, eaque ipsa quae ab illo inventore veritatis.
					</p>
				</div>
			</Reveal>
		</div>

		<div class="mh-origini__media">
			<Reveal client:visible inView delay={0.2} x={36} y={0} duration={1.05}>
				<img
					src="/images/masseria/origini.jpg"
					alt="Cortile della masseria tra archi e luce pugliese"
					width="1704"
					height="970"
					loading="lazy"
				/>
			</Reveal>
		</div>
	</div>

	<Reveal client:visible inView delay={0.15} y={20} duration={1.1} className="mh-origini__script-wrap">
		<p class="mh-origini__script">The origins reveal what time has preserved.</p>
	</Reveal>
</section>

<style>
	.mh-origini {
		position: relative;
		overflow-x: hidden;
		background: var(--brand-verde);
		color: var(--brand-avorio);
		/* spazio in basso per la script absolute */
		padding-bottom: clamp(7.5rem, 12vw, 10rem);
	}

	.mh-origini__inner {
		display: grid;
		grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.15fr);
		gap: clamp(2rem, 5vw, 4.5rem);
		align-items: center;
		max-width: 90rem;
		margin: 0 auto;
		padding: clamp(4rem, 8vw, 6.5rem) clamp(1.25rem, 5vw, 5rem) clamp(3rem, 6vw, 5rem);
	}

	.mh-origini__title {
		margin: 0 0 1.5rem;
		font-family: 'Times Sans Serif', sans-serif;
		font-weight: 400;
		font-size: clamp(1.85rem, 3.2vw, 2.75rem);
		line-height: 1.1;
		letter-spacing: 0.02em;
		color: var(--brand-avorio);
	}

	.mh-origini__text {
		display: grid;
		gap: 1.1rem;
		max-width: 32rem;
	}

	.mh-origini__text p {
		margin: 0;
		font-family: 'New Caledonia LT Std', serif;
		font-size: clamp(0.98rem, 1.15vw, 1.1rem);
		line-height: 1.65;
		color: rgba(233, 227, 211, 0.95);
	}

	.mh-origini__media {
		width: 100%;
		aspect-ratio: 16 / 10;
		overflow: hidden;
		min-width: 0;
	}

	.mh-origini__media :global(div) {
		width: 100%;
		height: 100%;
	}

	.mh-origini__media img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.mh-origini :global(.mh-origini__script-wrap) {
		position: absolute;
		left: clamp(1.25rem, 5vw, 5rem);
		bottom: clamp(1.25rem, 3vw, 2.25rem);
		z-index: 1;
		max-width: calc(100% - clamp(1.25rem, 5vw, 5rem));
		pointer-events: none;
	}

	.mh-origini__script {
		margin: 0;
		font-family: 'Monsieur La Doulaise', cursive;
		font-weight: 400;
		font-style: normal;
		font-size: 100px;
		line-height: 100px;
		letter-spacing: 0;
		white-space: nowrap;
		color: rgba(233, 227, 211, 0.55);
		text-align: left;
	}

	@media (max-width: 900px) {
		.mh-origini {
			padding-bottom: clamp(5rem, 18vw, 7rem);
		}

		.mh-origini__inner {
			grid-template-columns: 1fr;
			padding-bottom: 1.5rem;
		}

		.mh-origini__media {
			order: -1;
			aspect-ratio: 4 / 3;
		}

		.mh-origini__script {
			font-size: clamp(2.5rem, 12vw, 4rem);
			line-height: 1;
			white-space: normal;
		}
	}
</style>
