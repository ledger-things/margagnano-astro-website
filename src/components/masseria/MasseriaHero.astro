---
import Reveal from '../Reveal.tsx';
import I18n from '../I18n.astro';
---

<section class="mh-hero" aria-labelledby="mh-hero-title">
	<div class="mh-hero__texture" aria-hidden="true"></div>

	<div class="mh-hero__frame">
		<div class="mh-hero__media mh-hero__media--left">
			<Reveal client:load delay={0.15} x={-28} y={0} duration={1.15}>
				<img
					src="/images/masseria/hero-left.jpg"
					alt=""
					width="1040"
					height="1232"
					fetchpriority="high"
				/>
			</Reveal>
		</div>

		<div class="mh-hero__copy">
			<Reveal client:load delay={0.25} duration={1.05} y={28}>
				<h1 id="mh-hero-title" class="mh-hero__title">Masseria<br />Margagnano</h1>
			</Reveal>
			<Reveal client:load delay={0.4} duration={1} y={20}>
				<p class="mh-hero__subtitle">
					<I18n
						it="Un luogo dove architettura, paesaggio e tempo convivono in equilibrio."
						en="A place where architecture, landscape and time live in balance."
					/>
				</p>
			</Reveal>
			<Reveal client:load delay={0.55} y={16}>
				<a class="mh-hero__cta" href="#origini">View more</a>
			</Reveal>
		</div>

		<div class="mh-hero__media mh-hero__media--right">
			<Reveal client:load delay={0.3} x={28} y={0} duration={1.15}>
				<img
					src="/images/masseria/hero-right.png"
					alt=""
					width="888"
					height="1232"
					fetchpriority="high"
				/>
			</Reveal>
		</div>
	</div>
</section>

<style>
	.mh-hero {
		position: relative;
		isolation: isolate;
		overflow-x: clip;
		min-height: 100svh;
		background: #f3efe8;
		color: var(--brand-marrone);
	}

	.mh-hero__texture {
		position: absolute;
		inset: 0;
		z-index: 0;
		background-image: url('/images/home/masseria-texture.png');
		background-size: cover;
		background-position: center;
		opacity: 0.45;
		pointer-events: none;
	}

	.mh-hero__frame {
		position: relative;
		z-index: 1;
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(18rem, 26rem) minmax(0, 1fr);
		align-items: stretch;
		min-height: 100svh;
		padding-block: clamp(5.5rem, 9vh, 7rem) clamp(1.5rem, 3vh, 2.5rem);
		box-sizing: border-box;
	}

	.mh-hero__media {
		position: relative;
		overflow: hidden;
		width: min(100%, 27rem);
		height: min(62svh, 36rem);
	}

	.mh-hero__media :global(div) {
		width: 100%;
		height: 100%;
	}

	.mh-hero__media img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.mh-hero__media--left {
		justify-self: start;
		align-self: start;
		margin-left: clamp(-3.5rem, -3vw, -1rem);
	}

	.mh-hero__media--right {
		justify-self: end;
		align-self: end;
		width: min(100%, 25rem);
		margin-right: clamp(-3.5rem, -3vw, -1rem);
	}

	.mh-hero__copy {
		position: relative;
		z-index: 2;
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		justify-content: center;
		align-self: center;
		width: 100%;
		padding: 1rem 0.75rem;
		text-align: left;
		box-sizing: border-box;
	}

	.mh-hero__title {
		margin: 0;
		font-family: 'Times Sans Serif', sans-serif;
		font-weight: 400;
		font-size: clamp(1.75rem, 3.6vw, 3rem);
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--brand-terracotta);
		line-height: 1.15;
	}

	.mh-hero__subtitle {
		margin: 1.15rem 0 0;
		max-width: 18rem;
		font-family: 'Cardo', serif;
		font-style: italic;
		font-size: clamp(0.95rem, 1.25vw, 1.15rem);
		line-height: 1.45;
		color: var(--brand-verde);
	}

	.mh-hero__cta {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		margin-top: 1.75rem;
		min-width: 8.75rem;
		padding: 0.85rem 1.25rem;
		border: 1px solid var(--brand-verde);
		color: var(--brand-verde);
		text-decoration: none;
		font-family: 'Times Sans Serif', sans-serif;
		font-size: 0.78rem;
		letter-spacing: 0.2em;
		text-transform: uppercase;
		transition:
			background-color 0.25s ease,
			color 0.25s ease;
	}

	.mh-hero__cta:hover,
	.mh-hero__cta:focus-visible {
		background: var(--brand-verde);
		color: var(--brand-avorio);
		outline: none;
	}

	@media (max-width: 900px) {
		.mh-hero__frame {
			grid-template-columns: 1fr;
			min-height: auto;
			padding: 5rem 0 1.5rem;
			gap: 1.25rem;
		}

		.mh-hero__media {
			width: min(78%, 22rem);
			height: auto;
			aspect-ratio: 3 / 4;
		}

		.mh-hero__media--left {
			order: 1;
			margin-left: -1.25rem;
		}

		.mh-hero__copy {
			order: 2;
			max-width: 26rem;
			margin: 0 auto;
			padding: 1.25rem 1.5rem 1.75rem;
		}

		.mh-hero__media--right {
			order: 3;
			margin-right: -1.25rem;
			margin-left: auto;
			width: min(74%, 20rem);
		}
	}
</style>
