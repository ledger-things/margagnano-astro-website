---
import Reveal from '../Reveal.tsx';
import MasseriaImageCompare from './MasseriaImageCompare.tsx';
---

<section class="mh-compare" aria-label="Confronto immagini della masseria">
	<div class="mh-compare__inner">
		<Reveal client:visible inView delay={0.08} y={28} duration={1}>
			<MasseriaImageCompare client:visible />
		</Reveal>
	</div>
</section>

<style>
	.mh-compare {
		position: relative;
		overflow: hidden;
	}

	.mh-compare__inner {
		position: relative;
		z-index: 1;
		max-width: 90rem;
		margin: 0 auto;
		padding: clamp(4rem, 8vw, 6.5rem) clamp(1.25rem, 5vw, 5rem);
	}

	.mh-compare :global(.mh-compare__frame) {
		position: relative;
		width: 100%;
		aspect-ratio: 16 / 10;
		overflow: hidden;
		user-select: none;
		touch-action: none;
		cursor: ew-resize;
		isolation: isolate;
	}

	.mh-compare :global(.mh-compare__img) {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center;
		pointer-events: none;
		-webkit-user-drag: none;
	}

	.mh-compare :global(.mh-compare__img--after) {
		position: absolute;
		inset: 0;
	}

	.mh-compare :global(.mh-compare__img--before) {
		position: absolute;
		inset: 0;
		clip-path: inset(0 calc(100% - var(--mh-compare-pos, 50%)) 0 0);
	}

	.mh-compare :global(.mh-compare__divider) {
		position: absolute;
		top: 0;
		bottom: 0;
		left: var(--mh-compare-pos, 50%);
		z-index: 2;
		width: 2px;
		transform: translateX(-50%);
		background: rgba(233, 227, 211, 0.92);
		pointer-events: none;
		box-shadow: 0 0 0 1px rgba(107, 90, 68, 0.12);
	}

	.mh-compare :global(.mh-compare__knob) {
		position: absolute;
		top: 50%;
		left: 50%;
		display: grid;
		place-items: center;
		width: 2.75rem;
		height: 2.75rem;
		transform: translate(-50%, -50%);
		border-radius: 999px;
		background: rgba(233, 227, 211, 0.95);
		color: var(--brand-marrone);
		box-shadow:
			0 1px 2px rgba(107, 90, 68, 0.18),
			0 8px 24px rgba(107, 90, 68, 0.16);
	}

	.mh-compare :global(.mh-compare__slider) {
		position: absolute;
		top: 0;
		bottom: 0;
		left: var(--mh-compare-pos, 50%);
		z-index: 3;
		width: 2.75rem;
		transform: translateX(-50%);
		cursor: ew-resize;
		outline: none;
	}

	.mh-compare :global(.mh-compare__slider:focus-visible)::after {
		content: '';
		position: absolute;
		top: 50%;
		left: 50%;
		width: 3.1rem;
		height: 3.1rem;
		transform: translate(-50%, -50%);
		border-radius: 999px;
		border: 2px solid var(--brand-terracotta);
		pointer-events: none;
	}

	@media (max-width: 900px) {
		.mh-compare__inner {
			padding-block: clamp(3rem, 8vw, 4.5rem);
		}

		.mh-compare :global(.mh-compare__frame) {
			aspect-ratio: 4 / 3;
		}

		.mh-compare :global(.mh-compare__knob) {
			width: 2.5rem;
			height: 2.5rem;
		}
	}

	.mh-compare :global(.sr-only) {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}

	@media (prefers-reduced-motion: reduce) {
		.mh-compare :global(.mh-compare__img--before),
		.mh-compare :global(.mh-compare__divider),
		.mh-compare :global(.mh-compare__slider) {
			transition: none;
		}
	}
</style>
