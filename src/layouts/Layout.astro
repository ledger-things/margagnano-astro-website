---
import '../styles/global.css';

interface Props {
	title?: string;
}

const { title = 'Masseria Margagnano' } = Astro.props;
const indexable = Astro.locals.indexable ?? true;
---

<!doctype html>
<html lang="it">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="shortcut icon" href="/favicon.ico" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<meta name="apple-mobile-web-app-title" content="Masseria Margagnano" />
		<link rel="manifest" href="/site.webmanifest" />
		<meta name="theme-color" content="#f9f6ee" />
		<meta name="generator" content={Astro.generator} />
		<meta name="robots" content={indexable ? 'index, follow' : 'noindex, nofollow'} />
		<title>{title}</title>
		<script is:inline>
			(function () {
				try {
					var stored = localStorage.getItem('margagnano-lang');
					if (stored === 'en' || stored === 'it') document.documentElement.lang = stored;
				} catch (e) {}
			})();
		</script>
		<style is:inline>
			.i18n[data-lang='en'] {
				display: none !important;
			}
			html[lang='en'] .i18n[data-lang='it'] {
				display: none !important;
			}
			html[lang='en'] .i18n[data-lang='en'] {
				display: revert !important;
			}
		</style>
	</head>
	<body>
		<slot />
	</body>
</html>

<script>
	import Lenis from 'lenis';

	const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

	if (!prefersReduced) {
		const lenis = new Lenis({
			duration: 1.2,
			easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
			smoothWheel: true,
		});

		function raf(time: number) {
			lenis.raf(time);
			requestAnimationFrame(raf);
		}

		requestAnimationFrame(raf);
	}
</script>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
	}
</style>
