---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import RoomHero from '../../components/rooms/RoomHero.astro';
import RoomDetails from '../../components/rooms/RoomDetails.astro';
import RoomGallery from '../../components/rooms/RoomGallery.astro';
import RoomAdjacent from '../../components/rooms/RoomAdjacent.astro';
import { rooms, type Room } from '../../data/rooms';

export function getStaticPaths() {
	return rooms.map((room) => ({
		params: { slug: room.slug },
		props: { room },
	}));
}

interface Props {
	room: Room;
}

const { room } = Astro.props;
---

<Layout title={`${room.name} | Masseria Margagnano`}>
	<Header tone="light" />
	<main class="room-page">
		<RoomHero room={room} />
		<RoomDetails room={room} />
		<RoomGallery room={room} />
		<RoomAdjacent room={room} />
	</main>
	<Footer />
</Layout>
